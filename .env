# ECMWF Open Data
ECMWF_BASE_URL=https://data.ecmwf.int/forecasts
ECMWF_LOOKBACK_DAYS=3

# Период проверки: 6 часов
POLL_INTERVAL_SECONDS=21600

# Циклы запуска
TIME_SLOTS=["00z","06z","12z","18z"]

# Модель и разрешение
MODEL=ifs
RESOLUTION=0p25

# Каталоги потоков
TARGET_FOLDERS=["oper","wave"]

# MinIO
MINIO_ENDPOINT=grib_preprocessor_minio:10000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=adminminio
MINIO_SECURE=false
MINIO_BUCKET=ecmwf-data
MINIO_REGION=us-east-1

# Загрузки
MAX_PARALLEL_DOWNLOADS=20
RETRY_COUNT=3
RETRY_BACKOFF_SECONDS=2
HTTP_TIMEOUT_SECONDS=60

# Временные файлы
TEMP_DIR=/tmp/ecmwf-downloads

# Логирование
LOG_LEVEL=INFO

# FastAPI
API_HOST=0.0.0.0
API_PORT=8080
